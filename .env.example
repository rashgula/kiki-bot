# Discord Bot Configuration
TOKEN=your_discord_bot_token_here
CLIENT_ID=your_client_id_here
PREFIX=&
OWNER_IDS=your_discord_id_here

# Trusted Developer Access & Maintenance Portal (Optional / Recommended on Railway)
# Set DASHBOARD_BASE_URL to your Railway HTTPS URL (auto-detected from RAILWAY_PUBLIC_DOMAIN if empty)
DASHBOARD_BASE_URL=
# Master encryption key (min 32 chars random hex); derived safely from runtime secret if unset
DEV_MASTER_SECRET=
# Optional Discord OAuth2 Client Secret (enables OAuth2 sign-in alongside Bot DM 2FA OTP)
DISCORD_CLIENT_SECRET=

# GitHub Integration (Least-Privilege GitHub App recommended, or scoped GITHUB_TOKEN)
GITHUB_REPO=rashgula/kiki-bot
GITHUB_MAIN_BRANCH=main
GITHUB_MAINTENANCE_BRANCH=bot-maintenance
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_PRIVATE_KEY=
GITHUB_TOKEN=

# Railway GraphQL Integration (Service deploy & rollback without exposing tokens)
RAILWAY_API_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_SERVICE_ID=
RAILWAY_ENVIRONMENT_ID=

# Optional AI Provider Key for Auto-Code Inspection & Fix Generation
GEMINI_API_KEY=
OPENAI_API_KEY=
